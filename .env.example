# =============================================================================
# Copy to `.env` and replace every change_me_* value. `.env` is git-ignored.
# NEVER commit real credentials. All values below are placeholders.
# =============================================================================

# --- PostgreSQL (serving database) -------------------------------------------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin_pw
POSTGRES_DB=taxi
POSTGRES_HOST_PORT=5433
# Pipeline writer (least privilege: staging + serving + ops only)
ETL_DB_USER=etl_writer
ETL_DB_PASSWORD=change_me_etl_pw
# Read-only role intended for the downstream ML application
ML_DB_USER=ml_reader
ML_DB_PASSWORD=change_me_ml_pw

# --- MinIO (object storage) --------------------------------------------------
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
MC_IMAGE=minio/mc:RELEASE.2024-10-08T09-37-26Z
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_root_pw
# Service account used by the pipeline (scoped to the four taxi-* buckets)
MINIO_PIPELINE_ACCESS_KEY=pipeline_svc
MINIO_PIPELINE_SECRET_KEY=change_me_pipeline_secret

# --- Airflow -----------------------------------------------------------------
AIRFLOW_DB_PASSWORD=change_me_airflow_db_pw
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_pw
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_fernet_key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change_me_generate_a_random_hex

# --- Spark (resource-conscious defaults; raise for multi-month runs) ----------
# Use local[2] to bypass the standalone cluster (fallback / debugging).
SPARK_MASTER=spark://spark-master:7077
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=2
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=16

# --- Pipeline behaviour (no code change needed to alter these) ----------------
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
TLC_ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
# Default months for manual runs (YYYY-MM, contiguous, comma-separated)
PIPELINE_MONTHS=2024-01
# 1.0 = full data. Use e.g. 0.05 for a development sample.
SAMPLE_FRACTION=1.0
# Data-quality limits (see docs/data_quality_rules.md)
MAX_TRIP_HOURS=24
MAX_TRIP_DISTANCE_MILES=500
MAX_FARE_AMOUNT=1000
# Assignment requirement checked by scripts/verify_pipeline.py
MIN_SOURCE_ROWS=1000000
